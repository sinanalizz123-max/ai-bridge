# ai-bridge environment reference
#
# NOTE: ai-bridge does NOT read credentials from .env. Real secrets live in
# config/config.json which is generated on first run and is gitignored.
# This file documents the optional environment knobs so reviewers can see
# everything that is configurable.

# Set to "0" to cache the config in memory instead of re-reading it on every
# request (default "1" = parse config/config.json per request).
AI_BRIDGE_CFG_CHECK=1

# ---- Integration/auth checklist (values deliberately blank / placeholders) ----
# The bridge's access token is auto-generated into config/config.json.
# token       = <generated at first run, keep private>
# api_key     = <optional extra header auth, leave "" unless required>
#
# For ChatGPT Actions: import <public-url>/<token>/openapi.json with auth
# "No authentication". The token inside the URL path is the authentication.